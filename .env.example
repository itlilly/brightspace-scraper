# Copy to .env and fill in. .env is gitignored and must never be committed.
MUN_USERNAME=your_mun_login_id
MUN_PASSWORD=your_password

# Optional overrides
# BRIGHTSPACE_BASE_URL=https://online.mun.ca
# CAS_BASE_URL=https://login.mun.ca
# DATA_DIR=./data

# AI stage (local LLM, OpenAI-compatible endpoint — Ollama/LM Studio/llama.cpp/vLLM)
# LOCAL_LLM_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=qwen2.5:7b

# Google Calendar sync. Create a "Desktop app" OAuth client in Google Cloud Console
# (enable the Google Calendar API first). The refresh token is stored in the OS
# keychain after `calendar_sync auth`, NOT here.
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxx
# DEFAULT_DUE_TIME=23:59            # applied to date-only deadlines (flagged in the event)
# CALENDAR_TIMEZONE=America/St_Johns # MUN is UTC-3:30
# GOOGLE_OAUTH_PORT=8765            # loopback port used during the consent flow
